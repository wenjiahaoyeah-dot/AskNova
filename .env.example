# Local development template. Replace model settings with your provider's values.
# The provider must support Anthropic Messages and tool use.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

ASKNOVA_ENV=development
LOG_LEVEL=INFO
# For local Python; compose.yml overrides these with container service addresses.
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma
EVAL_BASELINE_PATH=./data/eval/baseline.json
ASKNOVA_SEED_DEMO_DOCS=true

# Disable the optional public documentation connection for the first local run.
MCP_EXTERNAL_ENABLED=false
MCP_SERVERS_CONFIG=config/mcp_servers.json
INTENT_EMBEDDING_PROVIDER=local
SILICONFLOW_API_KEY=

# 0 disables the extra metrics listener; /metrics is still served by FastAPI.
PROMETHEUS_PORT=0
MONITOR_INTERVAL=10
ALERT_WEBHOOK_URL=

ASKNOVA_INTENT_TIMEOUT_S=8
ASKNOVA_LLM_TIMEOUT_S=15
ASKNOVA_COMPOSER_TIMEOUT_S=8
PROFILE_UPDATE_MIN_INTERVAL_S=60

# Before external deployment: set ASKNOVA_ENV=production and configure user/admin
# tokens using a nonempty JSON mapping. Generate at least 24 random characters
# per token; these are independent of the model API key.
ASKNOVA_API_TOKENS=
